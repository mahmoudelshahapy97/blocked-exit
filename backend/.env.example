# ---------------------------------------------------------------------------
# InsightEye — Blocked Exit Detection
# Copy to .env and adjust. Every value here is a default from app/core/config.py
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=InsightEye Blocked Exit Detection
ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=*
LOG_LEVEL=INFO
LOG_JSON=false
# Interactive docs at /docs. Blank = on outside production, off in production.
ENABLE_DOCS=
# Browser page for drawing the exit region: /ui/zone-editor.html
ENABLE_ZONE_EDITOR=true

# --- Authentication ----------------------------------------------------------
# Signing key for every JWT this service issues. MUST be changed for anything
# other than local development -- the shipped default is a published literal
# and settings validation refuses to start with it when ENV=production.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
# The very first account to sign up becomes a platform admin and owns a
# workspace. Turn this off once that account exists, so signup becomes
# invitation-only (an admin adds people to a workspace by email/username).
ALLOW_OPEN_SIGNUP=true

# --- Database --------------------------------------------------------------
# Running uvicorn on the host, Postgres in Docker:
DATABASE_URL=postgresql+asyncpg://insighteye:insighteye@localhost:5432/blocked_exit
# On Windows with Docker inside WSL2 (no Docker Desktop), localhost forwarding
# is unreliable — use the WSL IP from `wsl hostname -I` instead:
# DATABASE_URL=postgresql+asyncpg://insighteye:insighteye@172.x.x.x:5432/blocked_exit
# Running the API inside docker compose, use the service name instead:
# DATABASE_URL=postgresql+asyncpg://insighteye:insighteye@postgres:5432/blocked_exit
DB_ECHO=false
# true = create tables at startup (dev). MUST be false with ENV=production —
# settings validation refuses to start otherwise, because the app would be
# mutating a schema that alembic is supposed to own.
AUTO_CREATE_TABLES=true
# Docker only: the entrypoint runs `alembic upgrade head` before uvicorn.
RUN_MIGRATIONS=true

# Consumed by the postgres container:
POSTGRES_USER=insighteye
POSTGRES_PASSWORD=insighteye
POSTGRES_DB=blocked_exit
# Host ports published by docker compose. Change these if 5432/8000 are already
# taken by another stack on your machine.
POSTGRES_PORT=5432
API_PORT=8000

# --- Models ----------------------------------------------------------------
# Bare names are auto-downloaded by ultralytics into MODEL_DIR.
MODEL_PATH=yolo11n.pt
SEG_MODEL_PATH=yolo11n-seg.pt
# Door-only weights for the door-centric strategy. Blank => strategy disabled
# and cameras fall back to DEFAULT_STRATEGY.
DOOR_MODEL_PATH=
DEVICE=cpu
CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.5
IMG_SIZE=640
# Segmentation masks measure partial obstruction accurately; boxes are faster.
USE_SEGMENTATION=true

# --- Strategy --------------------------------------------------------------
DEFAULT_STRATEGY=zone_based
TRACKER=bytetrack.yaml
ENABLE_TRACKING=true
DOOR_CENTRIC_EXPLAIN=true

# --- Blockage thresholds (percent of the exit still accessible) ------------
CLEAR_MIN_PCT=85
FULL_MAX_PCT=40

# --- Temporal filtering ----------------------------------------------------
# A blockage must hold this long before it is believed (ignores passers-by).
CONFIRM_SECONDS=5
CLEAR_SECONDS=3
# Frames analysed per second per camera (not the stream's own frame rate).
PROCESS_FPS=5

# --- Streaming -------------------------------------------------------------
RTSP_TRANSPORT=tcp
# Nothing received for this long means the source is gone, not hiccupping.
STREAM_READ_TIMEOUT_S=15
LOOP_VIDEO_FILES=true
JPEG_QUALITY=85
# Concurrent MJPEG viewers; each costs a JPEG encode per frame.
MAX_MJPEG_CLIENTS=8

# --- Worker supervision ----------------------------------------------------
# Restarts workers that died, errored, or stopped producing frames. Without it
# a failed worker silently stops monitoring its exit until someone notices.
WORKER_SUPERVISION_ENABLED=true
WORKER_SUPERVISION_INTERVAL_S=15
WORKER_RESTART_BACKOFF_BASE_S=5
WORKER_RESTART_BACKOFF_MAX_S=300

# --- Retention -------------------------------------------------------------
# Nothing is ever deleted without these. Set RETENTION_ENABLED=false only if an
# external archiver owns the data.
RETENTION_ENABLED=true
RETENTION_INTERVAL_S=21600
EVENT_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=90
SNAPSHOT_RETENTION_DAYS=30
# Hard ceiling on the snapshot directory; oldest are evicted first. 0 disables.
SNAPSHOT_MAX_TOTAL_MB=2048

# --- Alerting --------------------------------------------------------------
ALERTS_ENABLED=true
# Nothing fires until the blockage has persisted this long.
ALERT_MIN_DURATION_S=10
ALERT_COOLDOWN_S=300
WEBHOOK_URL=
WEBHOOK_TIMEOUT_S=10
# Retries after the first attempt, for 5xx and transport errors only.
WEBHOOK_RETRIES=2
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Risk scoring ----------------------------------------------------------
RISK_W_ACCESSIBILITY=0.45
RISK_W_DURATION=0.30
RISK_W_PEOPLE=0.15
RISK_W_CLASS=0.10
RISK_DURATION_SATURATION_S=120
