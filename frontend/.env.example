# Where the FastAPI backend is listening. The backend's own .env sets
# API_PORT=8001, so that is the default here; change both together.
VITE_API_TARGET=http://127.0.0.1:8001

# Dev server port for this console.
VITE_PORT=5173

# How often the dashboard re-polls /monitoring/status, in milliseconds.
VITE_POLL_INTERVAL_MS=3000
