# Production counterpart of the Vite dev proxy in vite.config.js.
#
# Same contract: the browser only ever talks to this origin, and nginx forwards
# /api (plus the backend's own /ui, /docs, /redoc, /openapi.json) to FastAPI.
# Auth is bearer JWT carried by the browser itself (see src/api/client.js) --
# nginx has no credential of its own to attach, unlike the old X-API-Key setup.
# Keep the two files in step -- a path proxied in dev but not here is a 404 that
# only shows up after a build.
#
# Rendered by envsubst at container start (see the Dockerfile), so
# ${BE_API_URL} comes from the environment rather than being baked in.

server {
    listen       80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # The MJPEG live view is an unbounded response; default timeouts would cut
    # a perfectly healthy stream after a minute.
    proxy_http_version 1.1;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    # The SPA owns its routes: /cameras/3/zone is React Router's, not a file.
    # Security headers. add_header in a location replaces the server's, so the
    # two locations that set their own cache headers repeat these.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # The API sets three of these too (for callers on its own port); keep one copy.
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed asset filenames: safe to cache hard. index.html must never be
    # cached, or a deploy leaves browsers pointing at assets that are gone.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location = /index.html {
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
    }

    # Live notifications: a WebSocket, so the upgrade has to be passed on and
    # the connection kept open far past the usual read timeout.
    location = /api/v1/notifications/ws {
        proxy_pass         ${BE_API_URL};
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
    }

    location /api/ {
        proxy_pass       ${BE_API_URL};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # MJPEG: buffering would hold the whole (endless) response.
        proxy_buffering  off;
    }

    # The backend's own zone editor and API docs, reachable without the
    # operator needing to know the API port.
    location /ui {
        proxy_pass       ${BE_API_URL};
        proxy_set_header Host $host;
    }

    location /docs {
        proxy_pass       ${BE_API_URL};
        proxy_set_header Host $host;
    }

    location /redoc {
        proxy_pass       ${BE_API_URL};
        proxy_set_header Host $host;
    }

    location = /openapi.json {
        proxy_pass       ${BE_API_URL};
        proxy_set_header Host $host;
    }

    gzip              on;
    gzip_types        text/css application/javascript application/json image/svg+xml;
    gzip_min_length   1024;
}
